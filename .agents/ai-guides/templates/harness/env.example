# .env.example — fonte canônica: templates/harness/env.example (1password-credentials-guide.md §1 passo 4), instalado por OP-03
# Variáveis públicas em texto puro; segredos como referências op://<Cofre>/<Item>/<campo> injetadas via `op run -- <comando>`
APP_ENV=local
APP_DEBUG=true

# Exemplos de segredos (substitua cofre/item/campo):
# DB_PASSWORD=op://<Cofre>/<Item>/password
# JWT_SECRET=op://<Cofre>/<Item>/secret_key
