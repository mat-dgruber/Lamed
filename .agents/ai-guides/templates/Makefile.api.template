        format lint test test-cov migration migrate migrate-down migrate-history run \
        setup setup-node setup-python install-browsers env check-env clean-env export-env \
        setup-gemini-hook pull-memory push-memory jail-setup jail-openclaude jail-gemini \
        check-node check-python check-pip

