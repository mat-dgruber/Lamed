# ==============================================================================
# 2. DOCKER & INFRAESTRUTURA
# ==============================================================================

dev: ## Build e start do ambiente de desenvolvimento
	@if [ -f "./build.sh" ]; then ./build.sh build dev; else docker compose -f docker-compose.dev.yml up -d --build; fi

prod: ## Build e start do ambiente de produção
	@if [ -f "./build.sh" ]; then ./build.sh build prod; else docker compose up -d --build; fi

start: ## Iniciar containers de desenvolvimento
	@if [ -f "./build.sh" ]; then ./build.sh start dev; else docker compose -f docker-compose.dev.yml up -d; fi

start-prod: ## Iniciar containers de produção
	@if [ -f "./build.sh" ]; then ./build.sh start prod; else docker compose up -d; fi

stop: ## Parar containers de desenvolvimento
	@if [ -f "./build.sh" ]; then ./build.sh stop dev; else docker compose -f docker-compose.dev.yml down; fi

stop-prod: ## Parar containers de produção
	@if [ -f "./build.sh" ]; then ./build.sh stop prod; else docker compose down; fi

restart: ## Reiniciar containers de desenvolvimento
	@if [ -f "./build.sh" ]; then ./build.sh restart dev; else docker compose -f docker-compose.dev.yml restart; fi

restart-prod: ## Reiniciar containers de produção
	@if [ -f "./build.sh" ]; then ./build.sh restart prod; else docker compose restart; fi

logs: ## Ver logs de desenvolvimento
	@if [ -f "./build.sh" ]; then ./build.sh logs dev; else docker compose -f docker-compose.dev.yml logs -f; fi

logs-prod: ## Ver logs de produção
	@if [ -f "./build.sh" ]; then ./build.sh logs prod; else docker compose logs -f; fi

status: ## Status de todos os containers
	@if [ -f "./build.sh" ]; then ./build.sh status; else docker compose ps; fi

health: ## Verificar saúde da aplicação
	@if [ -f "./build.sh" ]; then ./build.sh health; else curl -s http://localhost:8000/health || echo "Aplicação offline"; fi

clean: ## Limpar recursos Docker
	@if [ -f "./build.sh" ]; then ./build.sh cleanup; else docker compose down --remove-orphans; fi

clean-cache: ## Limpar cache de build Docker
	@echo "🧹 Limpando cache de build Docker..."
	@docker builder prune -f
	@docker system prune -f
	@echo "✅ Cache limpo"

clean-all: ## Limpar containers e volume do banco deste projeto
	@if [ -f "./build.sh" ]; then ./build.sh clean-all; else docker compose down -v; fi

# ==============================================================================
# 3. DESENVOLVIMENTO LOCAL & QUALIDADE (Zero-Turn)
# ==============================================================================

run: ## Rodar API localmente com uvicorn (sem Docker)
	PYTHONPATH=src uv run uvicorn app.main:app --reload --host 0.0.0.0 --port 8000

format: ## Formatar código com Ruff
	PYTHONPATH=src uv run ruff format src tests

lint: ## Verificar e corrigir código com Ruff
	PYTHONPATH=src uv run ruff check --fix src tests

test: ## Executar testes unitários e de integração
	PYTHONPATH=src uv run pytest tests/ -v

test-cov: ## Executar testes com relatório de cobertura
	PYTHONPATH=src uv run pytest tests/ --cov=src --cov-report=term-missing

# ==============================================================================
# 4. BANCO DE DADOS & MIGRAÇÕES (Alembic)
# ==============================================================================

migration: ## Gerar nova migração Alembic (uso: make migration msg="descrição")
	PYTHONPATH=src uv run alembic revision --autogenerate -m "$(msg)"

migrate: ## Aplicar migrações pendentes
	PYTHONPATH=src uv run alembic upgrade head

migrate-down: ## Reverter última migração
	PYTHONPATH=src uv run alembic downgrade -1

migrate-history: ## Ver histórico de migrações
	PYTHONPATH=src uv run alembic history --verbose

# ==============================================================================
# 5. AMBIENTE DE IA, HARNESS & MCPS
# ==============================================================================

check-node:
	@command -v node >/dev/null 2>&1 || (echo "Node.js não encontrado. Instale Node.js 18+." && exit 1)
	@command -v npm >/dev/null 2>&1 || (echo "npm não encontrado." && exit 1)

check-python:
	@command -v python3 >/dev/null 2>&1 || (echo "Python 3 não encontrado. Instale Python 3.9+." && exit 1)

check-pip:
	@python3 -m pip --version >/dev/null 2>&1 || (echo "pip não encontrado para python3." && exit 1)

setup-node: ## Instalar pacotes npm globais necessários (MCPs)
	@echo "Instalando pacotes npm globais dos MCPs..."
	@npm install -g $(NODE_NPX_PACKAGES)

setup-python: ## Instalar mempalace via pip
	@echo "Instalando MemPalace via pip..."
	@python3 -m pip install --upgrade pip
	@python3 -m pip install mempalace

install-browsers: ## Instalar browsers do Playwright
	@echo "Instalando browsers do Playwright..."
	@npx -y playwright install

env: ## Criar arquivo .env baseado no .env.example se não existir
	@if [ ! -f $(ENV_EXAMPLE_FILE) ]; then \
		echo "❌ Erro: $(ENV_EXAMPLE_FILE) não encontrado no repositório."; \
		exit 1; \
	fi
	@if [ -f $(ENV_FILE) ]; then \
		echo "ℹ️  $(ENV_FILE) já existe. Nenhuma alteração feita."; \
	else \
		cp $(ENV_EXAMPLE_FILE) $(ENV_FILE); \
		echo "✅ Arquivo $(ENV_FILE) criado a partir de $(ENV_EXAMPLE_FILE)."; \
		echo "📝 Edite o arquivo $(ENV_FILE) e configure as variáveis de ambiente necessárias."; \
	fi

check-env: ## Verificar se o .env existe e se há chaves não preenchidas
	@if [ ! -f $(ENV_FILE) ]; then \
		echo "❌ Erro: $(ENV_FILE) não encontrado. Execute 'make env' primeiro."; \
		exit 1; \
	fi
	@echo "🔍 Verificando chaves não preenchidas no $(ENV_FILE)..."
	@UNFILLED=$$(grep -i "your_" $(ENV_FILE) | cut -d= -f1 | tr -d ' '); \
	if [ -n "$$UNFILLED" ]; then \
		echo ""; \
		echo "⚠️  As seguintes variáveis ainda possuem valores placeholder:"; \
		echo "$$UNFILLED" | while IFS= read -r var; do echo "   • $$var"; done; \
		echo ""; \
	else \
		echo "✅ Todas as variáveis do $(ENV_FILE) estão preenchidas."; \
	fi

clean-env: ## Remover o arquivo .env atual
	@rm -f $(ENV_FILE)
	@echo "Arquivo $(ENV_FILE) removido."

export-env: ## Instrução para carregar variáveis de ambiente no shell
	@echo "⚠️  O Makefile não pode modificar seu terminal atual diretamente."
	@echo "👉 Para carregar as variáveis no seu shell, execute:"
	@echo ""
	@echo "   source scripts/load-env.sh"
	@echo ""

jail-setup: ## Instalar e configurar o ai-jail (sandbox para agentes de IA)
	@if [ -f "scripts/setup-ai-jail.sh" ]; then bash scripts/setup-ai-jail.sh; else echo "ai-jail pronto. Use 'make jail-openclaude' ou 'make jail-gemini'."; fi

jail-openclaude: ## Iniciar OpenClaude isolado dentro do sandbox ai-jail
	@ai-jail openclaude

jail-gemini: ## Iniciar Gemini CLI isolado dentro do sandbox ai-jail
	@ai-jail gemini-cli

pull-memory: ## Sincronizar memória global para o repositório local (Gemini + OpenClaude)
	@if [ -f ".gemini/sync-memory.sh" ]; then bash .gemini/sync-memory.sh pull; fi
	@if [ -f ".claude/sync-claude-memory.sh" ]; then bash .claude/sync-claude-memory.sh pull; fi

push-memory: ## Sincronizar memória local para o sistema global (Gemini + OpenClaude)
	@if [ -f ".gemini/sync-memory.sh" ]; then bash .gemini/sync-memory.sh push; fi
	@if [ -f ".claude/sync-claude-memory.sh" ]; then bash .claude/sync-claude-memory.sh push; fi

setup-gemini-hook: ## Configurar git pre-commit hook para sincronizar memórias e Ruff
	@echo "Configurando git pre-commit hook..."
	@mkdir -p .git/hooks
	@if [ -f .git/hooks/pre-commit ]; then \
		echo "Atualizando pre-commit hook existente..."; \
	else \
		echo "#!/bin/sh" > .git/hooks/pre-commit; \
	fi
	@if ! grep -q "sync-memory.sh pull" .git/hooks/pre-commit; then \
		echo "if [ -f .gemini/sync-memory.sh ]; then bash .gemini/sync-memory.sh pull; fi" >> .git/hooks/pre-commit; \
		echo "if [ -f .claude/sync-claude-memory.sh ]; then bash .claude/sync-claude-memory.sh pull; fi" >> .git/hooks/pre-commit; \
	fi
	@if ! grep -q "ruff format" .git/hooks/pre-commit; then \
		echo "PYTHONPATH=src uv run ruff format src tests" >> .git/hooks/pre-commit; \
		echo "PYTHONPATH=src uv run ruff check --fix src tests" >> .git/hooks/pre-commit; \
		echo "git add src tests .gemini/memory .claude/memory 2>/dev/null || true" >> .git/hooks/pre-commit; \
	fi
	@chmod +x .git/hooks/pre-commit
	@echo "✅ Pre-commit hook configurado com sucesso."

setup: check-node setup-node install-browsers env check-env ## Instalar dependências, MCPs, browsers e configurar .env
	@echo ""
	@echo "=================================================================================="
	@echo " ✅ Setup completo do Backend e Harness de IA concluído!"
	@echo " Para carregar as variáveis no seu shell atual, execute:"
	@echo ""
	@echo "      make export-env"
	@echo "=================================================================================="
